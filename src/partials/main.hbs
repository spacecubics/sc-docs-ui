<main class="article">
  <div class="content-frame">
    {{> toolbar}}
    <div class="content">
{{#if (eq page.layout '404')}}
      <div class="article-panel">
{{> article-404}}
      </div>
{{else}}
{{> toc}}
      <div class="article-panel">
{{> article}}
      </div>
{{/if}}
    </div>
  </div>
</main>
